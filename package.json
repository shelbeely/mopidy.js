{
  "name": "mopidy",
  "version": "1.3.0",
  "description": "Client lib for controlling a Mopidy music server over a WebSocket",
  "keywords": [
    "mopidy",
    "music",
    "client",
    "websocket",
    "json-rpc"
  ],
  "homepage": "https://mopidy.com/",
  "bugs": "https://github.com/mopidy/mopidy.js/issues",
  "license": "Apache-2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mopidy/mopidy.js"
  },
  "engines": {
    "bun": ">= 1.3.13"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target browser --format esm && bun build src/index.ts --outfile dist/index.cjs --target node --format cjs && bun build src/index.ts --outfile dist/index.iife.min.js --target browser --format iife --minify && tsc --emitDeclarationOnly --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test --isolate",
    "start": "bun --hot examples/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
