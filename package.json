{
  "name": "mopidy",
  "version": "1.3.0",
  "description": "Client lib for controlling a Mopidy music server over a WebSocket",
  "keywords": ["mopidy", "music", "client", "websocket", "json-rpc"],
  "homepage": "https://mopidy.com/",
  "bugs": "https://github.com/mopidy/mopidy.js/issues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/mopidy.ts",
  "module": "src/mopidy.ts",
  "types": "src/mopidy.ts",
  "exports": {
    ".": {
      "types": "./src/mopidy.ts",
      "bun": "./src/mopidy.ts",
      "import": "./src/mopidy.ts",
      "default": "./src/mopidy.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mopidy/mopidy.js"
  },
  "engines": {
    "bun": ">= 1.3.13"
  },
  "files": ["src/**/*", "dist/**/*"],
  "scripts": {
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "build": "bun build src/browser.ts --outfile dist/mopidy.js --target browser --format iife",
    "start": "bun examples/web.html"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.3"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
